# Use a flat, hoisted node_modules instead of pnpm's default symlink/hardlink
# virtual store. Some shared-hosting filesystems (Hostinger among them) don't
# materialize pnpm's .pnpm virtual-store links correctly, causing runtime
# "Cannot find module" errors for files that are present in the store but not
# reachable through a broken link — e.g. @swc/helpers/esm/_interop_require_default.js.
# A hoisted layout avoids that class of failure at the cost of pnpm's usual
# strictness about undeclared dependencies.
#
# pnpm 10+ actually reads `nodeLinker` from pnpm-workspace.yaml, not here —
# that's the setting that takes effect. This file is kept as a fallback for
# npm/yarn or older pnpm versions that still honor .npmrc.
node-linker=hoisted
