# ──────────────────────────────────────────────────────────────────────────
# WWC Streaming App — environment variables
# Copy this file to `.env.local` and fill in real values before going live.
# Every value below is a placeholder; nothing here is a working credential.
# ──────────────────────────────────────────────────────────────────────────

# Public base URL of the app. Used to build Stripe success/cancel redirect
# URLs and Open Graph metadata. In production, set this to your real domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth.js / NextAuth ───────────────────────────────────────────────────
# Random secret used to sign/encrypt session JWTs. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID → Web application). Add
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── Stripe ────────────────────────────────────────────────────────────────
# Test-mode secret key from the Stripe Dashboard (Developers → API keys).
STRIPE_SECRET_KEY=sk_test_placeholder
# Test-mode publishable key (only needed if you add Stripe.js on the client).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# Signing secret for the webhook endpoint. When testing locally with the
# Stripe CLI (`stripe listen --forward-to localhost:3000/api/stripe/webhook`),
# use the `whsec_...` value it prints.
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Stripe Price IDs for the two paid subscription tiers (Dashboard → Product
# catalog → create a recurring price for each plan, then paste the ID here).
STRIPE_PRICE_MONTHLY=price_placeholder_monthly
STRIPE_PRICE_ANNUAL=price_placeholder_annual

# Optional: a real test-mode Stripe customer ID to exercise the billing
# portal route (/api/stripe/portal) locally. In production this should come
# from the customer ID stored on the user record after their first checkout.
STRIPE_MOCK_CUSTOMER_ID=

# ── Admin ─────────────────────────────────────────────────────────────────
# Second-factor PIN required to view /admin (in addition to being signed in
# on an isAdmin account — see data/users.ts). Falls back to 062714 in code if
# unset; set this in production so the real PIN isn't just the source default.
ADMIN_PIN=062714
