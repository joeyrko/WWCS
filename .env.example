# ──────────────────────────────────────────────────────────────────────────
# WWC Streaming App — environment variables
# Copy this file to `.env.local` and fill in real values before going live.
# Every value below is a placeholder; nothing here is a working credential.
# ──────────────────────────────────────────────────────────────────────────

# Public base URL of the app. Used to build Stripe success/cancel redirect
# URLs and Open Graph metadata. In production, set this to your real domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth.js / NextAuth ───────────────────────────────────────────────────
# Random secret used to sign/encrypt session JWTs. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
NEXTAUTH_URL=http://localhost:3000

# ── Supabase (Postgres) ──────────────────────────────────────────────────
# Real persistence for users, orders, and password-reset tokens — see
# lib/supabase.ts and lib/data/users.ts. Project URL and keys live in the
# Supabase Dashboard → Settings → API. SUPABASE_SERVICE_ROLE_KEY bypasses
# Row Level Security, so it must never be exposed to the client (no
# NEXT_PUBLIC_ prefix) and never committed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth credentials (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID → Web application). Add
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Optional — when unset, "Forgot Password" falls back to showing the reset
# link directly in the UI instead of emailing it (handy for local dev).
# Get a key at https://resend.com/api-keys. To send from your own domain
# (recommended, better deliverability), verify it under Resend → Domains and
# add the DNS records it gives you, then set RESEND_FROM_EMAIL to an address
# on that domain. Until verified, Resend only delivers to the email on your
# own Resend account, regardless of RESEND_FROM_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=WWC+ <onboarding@resend.dev>

# ── Stripe ────────────────────────────────────────────────────────────────
# Test-mode secret key from the Stripe Dashboard (Developers → API keys).
STRIPE_SECRET_KEY=sk_test_placeholder
# Test-mode publishable key (only needed if you add Stripe.js on the client).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# Signing secret for the webhook endpoint. When testing locally with the
# Stripe CLI (`stripe listen --forward-to localhost:3000/api/stripe/webhook`),
# use the `whsec_...` value it prints.
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Stripe Price IDs for the three paid subscription tiers (Dashboard → Product
# catalog → create a recurring price for each plan, then paste the ID here).
# See data/plans.ts for current pricing (WWC+ Monthly $6.99, WWC+ Annual
# $69.99, WWC Legacy Pass $99.99).
STRIPE_PRICE_MONTHLY=price_placeholder_monthly
STRIPE_PRICE_ANNUAL=price_placeholder_annual
STRIPE_PRICE_LEGACY=price_placeholder_legacy

# ── Admin ─────────────────────────────────────────────────────────────────
# Second-factor PIN required to view /admin (in addition to being signed in
# on an isAdmin account — see the users table in Supabase). Falls back to
# 062714 in code if unset; set this in production so the real PIN isn't just
# the source default.
ADMIN_PIN=062714
